<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- The site AUTOMATICALLY tries this server first, then LocalDB, .\SQLEXPRESS and localhost.
         So normally you do NOT need to change anything.
         Only edit "Data Source=" if your SQL Server has a different name (e.g. DESKTOP-ABC\SQLEXPRESS). -->
    <add name="PlacementCS"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PlacementDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
    <!-- Example for SQL Express (delete the line above and use this instead):
    <add name="PlacementCS"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=PlacementDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
