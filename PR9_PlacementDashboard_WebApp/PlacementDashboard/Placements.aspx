<%@ Page Title="Placements" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Placements.aspx.cs" Inherits="PlacementDashboard.Placements" %>
<asp:Content ID="Content1" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
<h2>Placement Records</h2>
<asp:Label ID="lblMsg" runat="server" EnableViewState="false" />

<asp:SqlDataSource ID="sdsStudentList" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT StudentId, FullName FROM Students ORDER BY FullName" />
<asp:SqlDataSource ID="sdsCompanyList" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT CompanyId, CompanyName FROM Companies ORDER BY CompanyName" />
<asp:SqlDataSource ID="sdsPlacements" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT * FROM vw_PlacementReport WHERE (@Status='All' OR Status=@Status) ORDER BY PlacementDate DESC, PlacementId DESC"
 DeleteCommand="DELETE FROM Placements WHERE PlacementId=@PlacementId">
 <SelectParameters>
  <asp:ControlParameter Name="Status" ControlID="ddlStatusFilter" PropertyName="SelectedValue" Type="String" DefaultValue="All" />
 </SelectParameters>
</asp:SqlDataSource>
<asp:SqlDataSource ID="sdsPlacementInsert" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT PlacementId, StudentId, CompanyId, Role, PlacementDate, Status FROM Placements"
 InsertCommand="INSERT INTO Placements (StudentId, CompanyId, Role, PlacementDate, Status) VALUES (@StudentId, @CompanyId, @Role, @PlacementDate, @Status)">
 <InsertParameters>
  <asp:Parameter Name="StudentId" Type="Int32" />
  <asp:Parameter Name="CompanyId" Type="Int32" />
  <asp:Parameter Name="Role" Type="String" />
  <asp:Parameter Name="PlacementDate" Type="DateTime" />
  <asp:Parameter Name="Status" Type="String" />
 </InsertParameters>
</asp:SqlDataSource>

<div class="box"><h3>Add New Placement</h3>
 <asp:DetailsView ID="dvPlacement" runat="server" AutoGenerateRows="False" DataKeyNames="PlacementId"
  DataSourceID="sdsPlacementInsert" DefaultMode="Insert" OnItemInserted="dvPlacement_ItemInserted" CssClass="form" GridLines="None">
  <Fields>
   <asp:TemplateField HeaderText="Student">
    <InsertItemTemplate>
     <asp:DropDownList ID="ddlStudent" runat="server" DataSourceID="sdsStudentList" DataTextField="FullName"
      DataValueField="StudentId" SelectedValue='<%# Bind("StudentId") %>' />
    </InsertItemTemplate>
   </asp:TemplateField>
   <asp:TemplateField HeaderText="Company">
    <InsertItemTemplate>
     <asp:DropDownList ID="ddlComp" runat="server" DataSourceID="sdsCompanyList" DataTextField="CompanyName"
      DataValueField="CompanyId" SelectedValue='<%# Bind("CompanyId") %>' />
    </InsertItemTemplate>
   </asp:TemplateField>
   <asp:BoundField DataField="Role" HeaderText="Role" />
   <asp:TemplateField HeaderText="Date">
    <InsertItemTemplate>
     <asp:TextBox ID="txtDate" runat="server" TextMode="Date" Text='<%# Bind("PlacementDate") %>' />
    </InsertItemTemplate>
   </asp:TemplateField>
   <asp:TemplateField HeaderText="Status">
    <InsertItemTemplate>
     <asp:DropDownList ID="ddlStatus" runat="server" SelectedValue='<%# Bind("Status") %>'>
      <asp:ListItem>Placed</asp:ListItem><asp:ListItem>Offered</asp:ListItem><asp:ListItem>Pending</asp:ListItem>
     </asp:DropDownList>
    </InsertItemTemplate>
   </asp:TemplateField>
   <asp:CommandField ShowInsertButton="True" InsertText="Save" />
  </Fields>
 </asp:DetailsView>
</div>

<div class="box">
 <b>Show status:</b>
 <asp:DropDownList ID="ddlStatusFilter" runat="server" AutoPostBack="true">
  <asp:ListItem>All</asp:ListItem><asp:ListItem>Placed</asp:ListItem><asp:ListItem>Offered</asp:ListItem><asp:ListItem>Pending</asp:ListItem>
 </asp:DropDownList><br /><br />
 <asp:GridView ID="gvPlacements" runat="server" DataSourceID="sdsPlacements" DataKeyNames="PlacementId"
  AutoGenerateColumns="False" AutoGenerateDeleteButton="True" AllowPaging="True" PageSize="8" AllowSorting="True"
  CssClass="tbl" GridLines="None" EmptyDataText="No records found." OnRowDeleted="gvPlacements_RowDeleted">
  <Columns>
   <asp:BoundField DataField="PlacementId" HeaderText="ID" SortExpression="PlacementId" ReadOnly="True" />
   <asp:BoundField DataField="FullName" HeaderText="Student" SortExpression="FullName" ReadOnly="True" />
   <asp:BoundField DataField="Department" HeaderText="Dept" SortExpression="Department" ReadOnly="True" />
   <asp:BoundField DataField="CGPA" HeaderText="CGPA" SortExpression="CGPA" DataFormatString="{0:0.00}" HtmlEncode="false" ReadOnly="True" />
   <asp:BoundField DataField="CompanyName" HeaderText="Company" SortExpression="CompanyName" ReadOnly="True" />
   <asp:BoundField DataField="Role" HeaderText="Role" SortExpression="Role" ReadOnly="True" />
   <asp:BoundField DataField="PackageLPA" HeaderText="Package (LPA)" SortExpression="PackageLPA" DataFormatString="{0:0.00}" HtmlEncode="false" ReadOnly="True" />
   <asp:BoundField DataField="PlacementDate" HeaderText="Date" SortExpression="PlacementDate" DataFormatString="{0:dd-MMM-yyyy}" HtmlEncode="false" ReadOnly="True" />
   <asp:BoundField DataField="Status" HeaderText="Status" SortExpression="Status" ReadOnly="True" />
  </Columns>
 </asp:GridView>
</div>
</asp:Content>
