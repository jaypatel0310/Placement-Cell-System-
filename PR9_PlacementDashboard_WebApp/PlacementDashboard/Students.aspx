<%@ Page Title="Students" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Students.aspx.cs" Inherits="PlacementDashboard.Students" %>
<asp:Content ID="Content1" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
<h2>Manage Students</h2>
<asp:Label ID="lblMsg" runat="server" EnableViewState="false" />

<asp:SqlDataSource ID="sdsStudents" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT * FROM Students WHERE (@Dept='All' OR Department=@Dept) ORDER BY StudentId"
 InsertCommand="INSERT INTO Students(FullName,Department,CGPA,Email) VALUES(@FullName,@Department,@CGPA,@Email)"
 UpdateCommand="UPDATE Students SET FullName=@FullName,Department=@Department,CGPA=@CGPA,Email=@Email WHERE StudentId=@StudentId"
 DeleteCommand="DELETE FROM Students WHERE StudentId=@StudentId">
 <SelectParameters>
  <asp:ControlParameter Name="Dept" ControlID="ddlDept" PropertyName="SelectedValue" Type="String" DefaultValue="All" />
 </SelectParameters>
</asp:SqlDataSource>

<div class="box">
 <b>Filter by department:</b>
 <asp:DropDownList ID="ddlDept" runat="server" AutoPostBack="true">
  <asp:ListItem>All</asp:ListItem><asp:ListItem>Computer</asp:ListItem><asp:ListItem>IT</asp:ListItem>
  <asp:ListItem>Electronics</asp:ListItem><asp:ListItem>Mechanical</asp:ListItem><asp:ListItem>Electrical</asp:ListItem><asp:ListItem>Civil</asp:ListItem>
 </asp:DropDownList><br /><br />
 <asp:GridView ID="gvStudents" runat="server" DataSourceID="sdsStudents" DataKeyNames="StudentId"
  AutoGenerateColumns="False" AutoGenerateEditButton="True" AutoGenerateDeleteButton="True"
  AllowPaging="True" PageSize="10" CssClass="tbl" GridLines="None"
  OnRowDeleted="gvStudents_RowDeleted" OnRowUpdated="gvStudents_RowUpdated">
  <Columns>
   <asp:BoundField DataField="StudentId" HeaderText="ID" ReadOnly="True" />
   <asp:BoundField DataField="FullName" HeaderText="Name" />
   <asp:BoundField DataField="Department" HeaderText="Department" />
   <asp:BoundField DataField="CGPA" HeaderText="CGPA" />
   <asp:BoundField DataField="Email" HeaderText="Email" />
  </Columns>
 </asp:GridView>
</div>

<div class="box"><h3>Add New Student</h3>
 <asp:DetailsView ID="dvStudent" runat="server" DataSourceID="sdsStudents" DefaultMode="Insert"
  AutoGenerateRows="False" AutoGenerateInsertButton="True" CssClass="form" GridLines="None"
  OnItemInserted="dvStudent_ItemInserted">
  <Fields>
   <asp:BoundField DataField="FullName" HeaderText="Full Name" />
   <asp:TemplateField HeaderText="Department">
    <InsertItemTemplate>
     <asp:DropDownList ID="ddlD" runat="server" SelectedValue='<%# Bind("Department") %>'>
      <asp:ListItem>Computer</asp:ListItem><asp:ListItem>IT</asp:ListItem><asp:ListItem>Electronics</asp:ListItem>
      <asp:ListItem>Mechanical</asp:ListItem><asp:ListItem>Electrical</asp:ListItem><asp:ListItem>Civil</asp:ListItem>
     </asp:DropDownList>
    </InsertItemTemplate>
   </asp:TemplateField>
   <asp:BoundField DataField="CGPA" HeaderText="CGPA (e.g. 8.5)" />
   <asp:BoundField DataField="Email" HeaderText="Email" />
  </Fields>
 </asp:DetailsView>
</div>
</asp:Content>
