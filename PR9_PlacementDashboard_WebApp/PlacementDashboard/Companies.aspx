<%@ Page Title="Companies" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Companies.aspx.cs" Inherits="PlacementDashboard.Companies" %>
<asp:Content ID="Content1" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
<h2>Manage Companies</h2>
<asp:Label ID="lblMsg" runat="server" EnableViewState="false" />

<asp:SqlDataSource ID="sdsCompanies" runat="server" ConnectionString="<%$ ConnectionStrings:PlacementCS %>"
 SelectCommand="SELECT * FROM Companies ORDER BY CompanyId"
 InsertCommand="INSERT INTO Companies(CompanyName,Sector,PackageLPA) VALUES(@CompanyName,@Sector,@PackageLPA)"
 UpdateCommand="UPDATE Companies SET CompanyName=@CompanyName,Sector=@Sector,PackageLPA=@PackageLPA WHERE CompanyId=@CompanyId"
 DeleteCommand="DELETE FROM Companies WHERE CompanyId=@CompanyId" />

<div class="box">
 <asp:GridView ID="gvCompanies" runat="server" DataSourceID="sdsCompanies" DataKeyNames="CompanyId"
  AutoGenerateColumns="False" AutoGenerateEditButton="True" AutoGenerateDeleteButton="True"
  CssClass="tbl" GridLines="None" OnRowDeleted="gvCompanies_RowDeleted" OnRowUpdated="gvCompanies_RowUpdated">
  <Columns>
   <asp:BoundField DataField="CompanyId" HeaderText="ID" ReadOnly="True" />
   <asp:BoundField DataField="CompanyName" HeaderText="Company" />
   <asp:BoundField DataField="Sector" HeaderText="Sector" />
   <asp:BoundField DataField="PackageLPA" HeaderText="Package (LPA)" />
  </Columns>
 </asp:GridView>
</div>

<div class="box"><h3>Add New Company</h3>
 <asp:DetailsView ID="dvCompany" runat="server" DataSourceID="sdsCompanies" DefaultMode="Insert"
  AutoGenerateRows="False" AutoGenerateInsertButton="True" CssClass="form" GridLines="None"
  OnItemInserted="dvCompany_ItemInserted">
  <Fields>
   <asp:BoundField DataField="CompanyName" HeaderText="Company Name" />
   <asp:BoundField DataField="Sector" HeaderText="Sector" />
   <asp:BoundField DataField="PackageLPA" HeaderText="Package in LPA (e.g. 5.5)" />
  </Fields>
 </asp:DetailsView>
</div>
</asp:Content>
